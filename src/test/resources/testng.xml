<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Test Suite" verbose="1" parallel="methods" thread-count="2">

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
    </listeners>

    <!-- Login Tests -->
    <test name="Login Tests">
        <classes>
            <class name="com.tests.LoginTest"/>
        </classes>
    </test>

    <!-- Products / Inventory Tests -->
    <test name="Products Tests">
        <classes>
            <class name="com.tests.ProductsTest"/>
        </classes>
    </test>

</suite>
