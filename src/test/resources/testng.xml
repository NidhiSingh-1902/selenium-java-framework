<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Test Suite" verbose="1" parallel="methods" thread-count="2">

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
    </listeners>

    <!-- Login Tests -->
    <test name="Login Tests">
        <classes>
            <class name="com.tests.LoginTest"/>
        </classes>
    </test>

    <!-- Products / Inventory Tests -->
    <test name="Products Tests">
        <classes>
            <class name="com.tests.ProductsTest"/>
        </classes>
    </test>

    <!-- Product Detail Page Tests -->
    <test name="Product Detail Tests">
        <classes>
            <class name="com.tests.ProductDetailTest"/>
        </classes>
    </test>

    <!-- Cart Page Tests -->
    <test name="Cart Tests">
        <classes>
            <class name="com.tests.CartTest"/>
        </classes>
    </test>

    <!-- Checkout Step 1 Tests -->
    <test name="Checkout Step 1 Tests">
        <classes>
            <class name="com.tests.CheckoutStep1Test"/>
        </classes>
    </test>

    <!-- Checkout Step 2 Tests -->
    <test name="Checkout Step 2 Tests">
        <classes>
            <class name="com.tests.CheckoutStep2Test"/>
        </classes>
    </test>

    <!-- Order Complete Tests -->
    <test name="Order Complete Tests">
        <classes>
            <class name="com.tests.OrderCompleteTest"/>
        </classes>
    </test>

    <!-- Burger Menu Tests -->
    <test name="Menu Tests">
        <classes>
            <class name="com.tests.MenuTest"/>
        </classes>
    </test>

</suite>
